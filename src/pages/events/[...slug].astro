---
import Layout from "../../layouts/Layout.astro";
import PromoHero from "../../components/PromoHero.astro";
import {getCollection, getEntry, render} from "astro:content";
// import {fmtDateRange, fmtTimeWindow} from "../../domain/events/format.ts";
import SocialRow from "../../components/SocialRow.astro";
import HrDivider from "../../components/decor/HrDivider.astro";
import {getValidatedEventBySlug, getValidatedEventItem, loadValidatedEvents} from "../../domain/events/server.ts";
import EventDateRange from "../../components/EventDateRange.astro";
import EventTimeWindow from "../../components/EventTimeWindow.astro";
import {defaults} from "../../config/site.ts";
import ShareModal from "../../components/ShareModal.astro";
import {getImage, Image} from "astro:assets";
import {ImageGallery} from "../../components/ImageGalleryNoThumbs.tsx";
import {getBookables} from "../../domain/contact/utlis.ts";

const branding = await getEntry("branding", "main");

export async function getStaticPaths() {
    const entries = await loadValidatedEvents();
    return entries.map((e) => ({params: {slug: e.id}}));
}

const {slug} = Astro.params;
if (!slug) throw new Error("Missing event id param");

const entry = await getValidatedEventBySlug(slug);
if (!entry) throw new Error(`Event not found: ${slug}`);

const {Content} = await render(entry);
// const ev = entry.data;
const ev = await getValidatedEventItem(entry);

// console.log("ev.image", ev.image);
// console.log("ev.href");
const description = `Learn more about the following event: ${ev.title}`;
const ogImage = ev.ogPhotoTexted ?? ev.ogPhotoTextless ?? ev.image ?? branding?.data.sitewideOGPhoto ?? defaults.ogPhoto;
const guest = ev.guestSpot;
const guestCsb = guest?.contactSocialsBooking;
const hasBookables = (getBookables(guestCsb)?.length ?? 0) > 0;
console.log("guest", guest);
console.log("hasBookables", hasBookables);


const lightboxImages = await Promise.all(
    (ev.images ?? []).map(async (img, idx) => {
        const lightbox = await getImage({
            src: img,
            // widths: [720, 960, 1280, 1600],
            widths: [720, 1080, 1440, 1920, 2400, 2880],
            sizes: "100vw",
            format: "webp",
            quality: 80,
        });

        // currently not using this, but keeping for posterity:
        const thumb = await getImage({
            src: img,
            width: 640,
            format: "webp",
            quality: 70,
        });

        return {
            src: lightbox.src,
            thumbSrc: thumb.src,
            srcSet: lightbox.srcSet.attribute,
            sizes: "100vw",
            width: Number(lightbox.attributes.width),
            height: Number(lightbox.attributes.height),
            alt: `${ev.title} gallery image ${idx + 1}`,
        };
    })
);
---
<script>
    import {bootFadeUp} from "../../scripts/fade-up";

    bootFadeUp({observeMutations: true});
</script>
<Layout title={ev.title} description={description} ogImage={ogImage}>
    <article class="page-article page-article--stack space-y-6">
        <h1 class="page-heading">{ev.title}</h1>

        {
            ev.image && (
                        <PromoHero isEventPage image={ev.image} alt={ev.alt ?? ev.title}/>
            )
        }

        <div id="event-details" data-section="event-details" class="border border-black/10 p-5 md:p-6">
            <div class="text-sm opacity-80">
                <!--{fmtDateRange(ev)}-->
                <EventDateRange ev={ev}/>
                {" • "}
                <!--{fmtTimeWindow(ev)}-->
                <EventTimeWindow ev={ev}/>
                {ev.location ? ` • ${ev.location}` : ""}
                <ShareModal shareTitle={ev.title} shareHero={ogImage} variant={2} shellClass="inline-block"
                            cardButtonClass="mx-2" cardRadius="0.375rem" variant2ShareText="share event"
                            heroFullBleed={true}/>
            </div>

            <div id="event-info" data-section="event-info" class="prose mt-4 max-w-none">
                <Content/>
            </div>
            <!--{-->
            <!--    (() => {-->
            <!--        const guest = ev.guestSpot;-->
            <!--        const socials = guest?.contactSocialsBooking?.socials;-->
            <!--        if (!socials) return null;-->

            <!--        const guestNamePossessive = guest.guestName.endsWith("s") ? guest.guestName + "'" : guest.guestName + "'s";-->

            <!--        return (-->
            <!--                <>-->
            <!--                    <HrDivider className="opacity-20"/>-->
            <!--                    <div class="mt-4 text-center">-->
            <!--                        <p class="text-sm font-medium">Check out-->
            <!--                            <span-->
            <!--                                    class="font-semibold">{guestNamePossessive}-->
            <!--                            </span>-->
            <!--                            work here:-->
            <!--                        </p>-->
            <!--                        <div class="flex justify-center">-->
            <!--                            <SocialRow-->
            <!--                                    links={socials}-->
            <!--                                    class="my-3"-->
            <!--                            />-->
            <!--                        </div>-->
            <!--                    </div>-->
            <!--                </>-->
            <!--        )-->
            <!--    })-->
            <!--}-->
            {guest &&
                (() => {
                    <!--const guest = ev.guestSpot;-->
                    const socials = guestCsb?.socials;
                    if (!socials) return null;

                    const guestNamePossessive = guest.guestName.endsWith("s") ? guest.guestName + "'" : guest.guestName + "'s";

                    return (
                            <>
                                <HrDivider className="opacity-20"/>
                                <div class="mt-4 text-center">
                                    <p class="text-sm font-medium">Check out
                                        <span
                                                class="font-semibold">{guestNamePossessive}
                                        </span>
                                        work here:
                                    </p>
                                    <div class="flex justify-center">
                                        <SocialRow
                                                links={socials}
                                                class="my-3"
                                        />
                                    </div>
                                </div>
                            </>
                    )
                })
            }
        </div>

        {guest && hasBookables &&
            (() => {
                    const bookingToggleId = `person-guest-${ev?.id?.replaceAll("/", "-")}-toggle`;
                    const guestBookingHref = `/booking#${bookingToggleId}`;
                    return (
                            <section class="mx-auto max-w-6xl px-4 sm:px-6 lg:px-10 pb-10 js-fade-up">
                                <div
                                        class="panel flex flex-col sm:flex-row sm:items-center sm:justify-between gap-4"
                                        data-color-theme="dune"
                                >
                                    <div>
                                        <h2 class="text-xl font-semibold tracking-tight">
                                            Want to book with {guest.guestName}?
                                        </h2>
                                        <p class="mt-1 text-sm">
                                            View booking details, contact channels, and appointment options.
                                        </p>
                                    </div>

                                    <a
                                            href={guestBookingHref}
                                            class="button-sharp px-6 py-2"
                                    >
                                        Book now
                                    </a>
                                </div>
                            </section>
                            <aside
                                    class="fixed-cta fixed inset-x-0 bottom-0 z-40 p-2 sm:hidden m-0"
                                    aria-label={`Booking call to action for ${guest.guestName}`}
                            >
                                <a
                                        href={guestBookingHref}
                                        class="button-sharp lantern-opaque-70 block w-full py-3 backdrop-blur"
                                        aria-label={`Book an appointment with ${guest.guestName}`}
                                        data-color-theme="lantern"
                                >
                                    Book with {guest.guestName}
                                </a>
                                <script is:inline>
                                    (() => {
                                        const root = document.documentElement;
                                        const parent = document.currentScript?.parentElement;
                                        if (!root || !parent) return;

                                        const measured = `${parent.offsetHeight}px`;
                                        root.style.setProperty("--fixed-booking-button-h", measured);
                                    })();
                                </script>
                            </aside>
                    )
                }
            )
        }

        <!--//////////////-->


        {
            ev.images?.length && lightboxImages && (
                        <section aria-labelledby="gallery-heading" class="my-5">
                            <h2 id="gallery-heading"
                                class="text-3xl sm:text-4xl md:text-5xl lg:text-6xl text-center">
                                Event Gallery
                            </h2>
                            <div class="flex items-end justify-between gap-4 mb-3 sm:mb-4 md:mb-5 lg:mb-7">
                                <p class="text-sm text-gray-600">
                                    Tap/click to view full size.
                                </p>


                                <p class="text-xs text-gray-500">
                                    {ev.images.length} photos
                                </p>
                            </div>

                            <div class="gallery">
                                {ev.images.map((img, idx) => (
                                        <button
                                                type="button"
                                                class="gallery-item cursor-pointer"
                                                data-idx={idx}
                                                onclick={`window.dispatchEvent(new CustomEvent("open-lightbox", { detail: { index: ${idx} } }))`}
                                        >
                                            <Image
                                                    src={img}
                                                    widths={[240, 360, 480, 512, 720]}
                                                    sizes="auto, 100vw"
                                                    alt={`${ev.title} gallery image ${idx + 1}`}
                                                    loading="lazy"
                                                    decoding="async"
                                                    class="block w-full h-auto rounded-2xl shadow-md"
                                            />
                                        </button>
                                ))}
                                <style>
                                    .gallery {
                                        columns: 4 250px;
                                        column-gap: 1rem;
                                        @media (max-width: 767px) {
                                            column-count: 2;
                                            column-width: auto;
                                            column-gap: 0.75rem;
                                        }
                                    }

                                    .gallery-item {
                                        display: block;
                                        width: 100%;
                                        break-inside: avoid;
                                        margin-bottom: 1rem;

                                        padding: 0;
                                        border: 0;
                                        background: transparent;
                                        @media (max-width: 767px) {
                                            margin-bottom: 0.75rem;
                                        }
                                    }

                                    .gallery-item img {
                                        display: block;
                                        width: 100%;
                                        max-width: none;
                                        height: auto;

                                        border-radius: 16px;
                                        box-shadow: 0 4px 12px rgba(0, 0, 0, .15);
                                    }
                                </style>
                            </div>

                            <ImageGallery
                                    client:load
                                    images={lightboxImages}
                            />
                        </section>
            )
        }

        <p class="text-sm">
            <a class="underline hover:no-underline" href="/events">← Back to Events</a
            >
        </p>
    </article>
</Layout>
