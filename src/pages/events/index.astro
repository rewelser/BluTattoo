---
// SSR on this page only. Elsewhere, SSG
// export const prerender = false;

// src/pages/index.astro
import Layout from "../../layouts/Layout.astro";
import {EventsCalendar} from "../../components/EventsCalendar.tsx";
import UpcomingEvents from "../../components/UpcomingEvents.astro";
import UpcomingEventsFallback from "../../components/UpcomingEventsFallback.astro";
import {getValidatedEventItemsCached} from "../../domain/events/server.ts";
import type {EventItem} from "../../domain/events/types.ts";
import EventsPageHeading from "../../components/decor/EventsPageHeading.astro";

import {getImage} from "astro:assets";
import NewsLetterFormModal2 from "../../components/NewsLetterFormModal2.astro";

const events: EventItem[] = await getValidatedEventItemsCached();

const eventsWithImageSrc = await Promise.all(events
    .map(async (e) => {
            if (e.image) {
                const image = await getImage({
                    src: e.image,
                    width: 200,
                    format: "webp",
                    quality: 80,
                });
                const imageSrc = image.src;
                return {
                    ...e,
                    imageSrc: imageSrc,
                }
            } else {
                return {
                    ...e,
                    imageSrc: undefined
                };
            }
        }
    )
)

const title = "Events";
const description = "View upcoming guest spots, events, and special appearances at BluTattoo.";
---

<Layout title={title} description={description}>
    <article class="page-article page-article--stack space-y-6">
        <header>
            <h1 class="page-heading sr-only">{title}</h1>
            <EventsPageHeading title={title}/>

        </header>

        <NewsLetterFormModal2></NewsLetterFormModal2>

        <UpcomingEvents events={events} server:defer>
            <UpcomingEventsFallback slot="fallback"/>
        </UpcomingEvents>

        <!-- <UpcomingEventsFallback slot="fallback" /> -->

        <!--<EventsCalendar client:load events={events} />-->
        <EventsCalendar client:only="react" events={eventsWithImageSrc}/>
    </article>
</Layout>
