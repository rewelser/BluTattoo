---
import type {ImageMetadata} from "astro";

interface Props {
    isEventPage?: boolean,
    href?: string,
    image: ImageMetadata,
    alt?: string,
    className?: string,
}

const {isEventPage = false, href = "/events/", image, alt = "", className = ""} = Astro.props;
---

<div
        class={`promo-hero-container relative overflow-hidden rounded-sm sm:rounded-none sm:p-8 ${className}`}
        data-promo-hero-root
>
    <div data-skeleton-image class="skeleton-promo-hero-image"></div>
    {!isEventPage ? (
            <a href={href}>
                <img
                        data-promo-image
                        src={image.src}
                        alt={`${alt} – view event details`}
                        class="w-full h-auto hidden opacity-0 transition-opacity duration-300 rounded-sm sm:rounded-none"
                        loading="eager"
                        fetchpriority="high"
                        decoding="sync"
                />
            </a>
    ) : (
            <button
                    type="button"
                    data-scroll-to-event-btn data-destination="event-details"
                    class="cursor-pointer w-full block"
            >
                <img
                        data-promo-image
                        src={image.src}
                        alt={`${alt} – jump to event information`}
                        class="w-full h-auto hidden opacity-0 transition-opacity duration-300 rounded-sm sm:rounded-none"
                        loading="eager"
                        fetchpriority="high"
                        decoding="sync"
                />
            </button>
    )}

</div>

<style>
    .promo-hero-container {
        box-shadow: 2px 2px 20px rgb(0 0 0 / 50%);

        @media (width >= 40rem) {
            box-shadow: 2px 2px 20px rgb(0 0 0 / 30%);
        }
    }
</style>

<script is:inline>
    (() => {
        async function initPromoImage(root) {
            const img = root.querySelector("[data-promo-image]");
            const skeleton = root.querySelector("[data-skeleton-image]");
            if (!img || !skeleton) return;

            const reveal = async () => {
                try {
                    await img.decode();
                } catch {
                }

                requestAnimationFrame(() => {
                    img.classList.remove("hidden");
                    skeleton.remove();

                    requestAnimationFrame(() => {
                        img.classList.remove("opacity-0");
                    });
                });
            };

            if (img.complete) {
                reveal();
            } else {
                img.addEventListener("load", reveal, {once: true});
            }
        }

        const root = document.currentScript?.previousElementSibling;
        if (root?.matches("[data-promo-hero-root]")) {
            initPromoImage(root);
        }

        const scrollBtn = document.querySelector("[data-scroll-to-event-btn]");
        if (scrollBtn) {
            scrollBtn.addEventListener("click", e => {
                const destinationValue = scrollBtn.dataset.destination;
                const target = document.querySelector(`[data-section="${destinationValue}"]`);

                if (target) {
                    target.scrollIntoView({block: "nearest", behavior: 'smooth'});
                }
            })
        }
    })();
</script>
