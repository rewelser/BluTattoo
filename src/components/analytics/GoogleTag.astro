---
import {GTAG_ID_STAGE, GTAG_ID_PROD} from "../../domain/analytics/defs.ts";
import type {ConsentPreferences, GAConsent} from "../../domain/analytics/types.ts";
import {alignDefaultGAConsentToPrefs} from "../../domain/analytics/utils.ts";

const {
    consentPrefs,
    isNoIndex,
} = Astro.props as {
    consentPrefs: ConsentPreferences;
    isNoIndex: boolean;
}

const consent = alignDefaultGAConsentToPrefs(consentPrefs);

const gtagId = isNoIndex ? GTAG_ID_STAGE : GTAG_ID_PROD;
---
<script async define:vars={{gtagId}} src=`https://www.googletagmanager.com/gtag/js?id=${gtagId}`></script>
<script define:vars={{consent, gtagId}}>
    window.dataLayer = window.dataLayer || [];

    window.gtag =
        window.gtag ||
        function gtag() {
            window.dataLayer.push(arguments);
        };

    gtag('consent', 'default', consent);
    gtag('js', new Date());
    gtag('config', `${gtagId}`);
</script>