---
---
<button
        type="button"
        command="show-modal"
        commandfor="contact-modal"
        class="button"
>
    Sign up for some things
</button>

<dialog
        closedby="any"
        id="contact-modal"
        class="dialog-outer"
>
    <div class="dialog-inner">
        <div class="flex h-full flex-col p-5 sm:p-6">
            <div class="flex items-start justify-between gap-4">
                <div>
                    <h2 class="text-xl font-semibold tracking-tight">
                        Stay in the loop
                    </h2>

                    <p class="mt-1 text-sm text-gray-700">
                        Enter your email to receive studio news and updates.
                    </p>
                </div>

                <button
                        type="button"
                        command="close"
                        commandfor="contact-modal"
                        aria-label="Close email signup"
                        class="button-sharp button-sharp-sub against-light h-8 w-8 shrink-0"
                >
                    ×
                </button>
            </div>

            <form
                    action="/your-email-endpoint"
                    method="post"
                    class="mt-auto"
            >
                <label
                        for="signup-email"
                        class="block text-sm font-medium"
                >
                    Email address
                </label>

                <div class="mt-2 flex flex-col gap-3 sm:flex-row">
                    <input
                            id="signup-email"
                            name="email"
                            type="email"
                            autocomplete="email"
                            placeholder="you@example.com"
                            required
                            class="input-sharp against-light"
                    />

                    <button
                            type="submit"
                            class="button-sharp against-light px-6 py-2"
                    >
                        Sign up
                    </button>
                </div>
            </form>
        </div>
    </div>
    <style>
        .dialog-outer {
            flex-direction: column;
            place-items: center;
            place-content: center;

            background-color: transparent;
            background-image: linear-gradient(45deg, transparent 33.33%, black 33.33%, black 50%, transparent 50%, transparent 83.33%, black 83.33%, black 100%);
            background-size: 0.28rem 0.28rem;
            margin: auto;
            //aspect-ratio: 1;
            padding: 25px;

            translate: 0 30px;
            opacity: 0;
            transition-property: display, overlay, opacity, translate;
            transition-duration: 0.3s;
            transition-behavior: allow-discrete;
        }


        .dialog-outer[open] {
            display: flex;
            opacity: 1;
            translate: 0 0;

            @starting-style {
                opacity: 0;
                translate: 0 30px;
            }
        }

        .dialog-outer::backdrop {
            background-color: transparent;
            transition: background-color 0.3s allow-discrete;
        }

        .dialog-outer[open]::backdrop {
            background-color: rgba(0, 0, 0, 0.3);

            @starting-style {
                background-color: transparent;
            }
        }

        .dialog-inner {
            height: 100%;
            width: 100%;
            //width: 90%;
            //height: 90%;
            background: seashell;
            border: 1px solid black;
            box-sizing: border-box;
        }

    </style>
</dialog>