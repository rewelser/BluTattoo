---
import SimpleSlottableBottomBanner from "../components/scaffolding/SimpleSlottableBottomBanner.astro";
const dataConsentBannerId = "data-consent-banner";
const dataConsentBannerTitleId = `${dataConsentBannerId}-title`;
const dataConsentBannerDescriptionId = `${dataConsentBannerId}-description`;
---


<SimpleSlottableBottomBanner
        id={dataConsentBannerId}
        closeLabel="Close email signup"
        labelledby={dataConsentBannerTitleId}
        describedby={dataConsentBannerDescriptionId}
>
    <button
            autofocus
            slot="trigger"
            type="button"
            command="show-modal"
            commandfor={dataConsentBannerId}
            class="button"
    >
        Sign up for some things
    </button>

    <div slot="header">
        <h2
                id={dataConsentBannerTitleId}
                class="text-xl font-semibold tracking-tight"
        >
            Stay in the loop
        </h2>

        <p
                id={dataConsentBannerDescriptionId}
                class="mt-1 text-sm text-gray-700"
        >
            Enter your email to receive studio news and updates.
        </p><a href="/cookies" class="inline-block">Cookie Policy</a>
    </div>
</SimpleSlottableBottomBanner>

<script define:vars={{dataConsentBannerId}}>
    (() => {
        const dialog = document.querySelector(`#${dataConsentBannerId}`);
        if (!dialog) return;

        function handleScroll() {
            const triggerPosition = 800;

            if (
                dialog &&
                !dialog.open &&
                window.scrollY >= triggerPosition
            ) {
                dialog.show();
                window.removeEventListener("scroll", handleScroll);
            }
        }

        window.addEventListener("scroll", handleScroll, {passive: true});
    })()
</script>