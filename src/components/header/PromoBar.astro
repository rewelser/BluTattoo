---
const {
    id = "promo-bar",
    storageKey = "bt_promo_dismissed",
    message = "Now booking!",
    href = "/booking",
    color1,
    color2,
    textColor
} = Astro.props;

const duration = 260;

const defaultBgC1 = `#020024`;
const defaultBgC2 = `#5613ff`;
// const defaultBg = "linear-gradient(90deg, #020024 0%, #005eff 100%)";
const defaultBg = `linear-gradient(90deg, ${defaultBgC1} 0%, ${defaultBgC2} 100%)`;

const c1 = typeof color1 === "string" && color1.trim() ? color1.trim() : "";
const c2 = typeof color2 === "string" && color2.trim() ? color2.trim() : "";

// Rules:
// - 0 colors -> default gradient
// - 1 color  -> solid
// - 2 colors -> simple 2-stop gradient
const background =
    c1 && c2
        ? `linear-gradient(90deg, ${c1} 0%, ${c2} 100%)`
        : c1
            ? c1
            : defaultBg;

const verbiageColor =
    textColor
        ? textColor
        : (c1 && c2)
            ? `contrast-color(color-mix(in oklab, ${c1}, ${c2}))`
            : c1
                ? `contrast-color(${c1})`
                : `contrast-color(color-mix(in oklab, ${defaultBgC1}, ${defaultBgC2}))`;
---
<>
    <aside
            id={id}
            class="promo-bar fixed top-0 left-0 w-full z-[80]"
            role="region"
            aria-label="Announcement"
    >
        <div
                class="h-full flex items-center justify-center gap-3 py-2 px-4 text-md text-xs sm:text-base md:text-2xl"
                style={`background: ${background};`}
        >
            <a
                    class="promo-bar-text-color promo-outline flex items-center justify-center w-full h-full text-center"
                    href={href}
            >
                {message}
            </a>
            <button
                    type="button"
                    class="promo-bar-text-color ml-auto px-2 py-1 leading-none cursor-pointer"
                    aria-label="Dismiss announcement"
                    data-dismiss
            >
                ✕
            </button>
        </div>
    </aside>

    <style define:vars={{verbiageColor}}>
        .promo-bar {
            transform: translateY(0);
            view-transition-name: promo-bar;
        }

        .promo-bar-text-color {
            color: var(--verbiageColor);
        }

        html[data-load="direct"] .promo-bar:not([data-promo-state="dismiss"]) {
            transition: transform var(--promo-bar-duration) ease;
        }

        @starting-style {
            html[data-load="direct"] .promo-bar:not([data-promo-state="dismiss"]) {
                transform: translateY(-100%);
            }
        }

        html[data-load="internal"] .promo-bar:not([data-promo-state="dismiss"]) {
            transform: translateY(0);
            transition: none;
        }

        .promo-bar[data-promo-state="dismiss"] {
            transform: translateY(-100%);
            transition: transform var(--promo-bar-duration) ease;
        }
    </style>

    <script define:vars={{storageKey, id, duration}}>
        (() => {
            const root = document.documentElement;
            const promoBar = document.getElementById(id);

            const setRootNavOrigin = () => {
                const navFrom = globalThis.navigation?.activation?.from;
                const internalNav = !!navFrom?.url && new URL(navFrom.url).origin === location.origin;
                root.dataset.load = internalNav ? "internal" : "direct";
            }

            const setAnnouncementHeight = (value) => {
                root.style.setProperty("--promo-bar-h", value);
            }

            const show = () => {
                const measured = `${promoBar.offsetHeight}px`;
                setAnnouncementHeight(measured);
            }

            const hide = () => {
                promoBar.setAttribute("data-promo-state", "dismiss");
                setAnnouncementHeight("0px");
            }

            let dismissed;

            try {
                dismissed = localStorage.getItem(storageKey) === "1";
            } catch {
                dismissed = false;
            }

            setRootNavOrigin();

            if (!dismissed) {
                show();
            } else {
                hide();
            }

            promoBar.querySelector("[data-dismiss]")?.addEventListener("click", () => {
                try {
                    localStorage.setItem(storageKey, "1");
                    // localStorage.
                } catch {
                }
                hide();
            })

            // this is probably fine, but replaced with one after (decide later):
            // window.addEventListener(
            //     "resize",
            //     () => {
            //         if (!dismissed) {
            //             show();
            //         }
            //     },
            //     {passive: true},
            // );

            window.addEventListener(
                "resize",
                () => {
                    if (promoBar.getAttribute("data-promo-state") !== "dismiss") {
                        show();
                    }
                },
                {passive: true},
            );
        })();
    </script>
</>
