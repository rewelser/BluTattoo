---
const {
    id,
    useCloseButton = true,
    closeLabel = "Close aside",
    labelledby,
    describedby,
    class: className,
    ...rest
} = Astro.props as {
    id: string;
    useCloseButton: boolean;
    closeLabel?: string;
    labelledby?: string;
    describedby?: string;
    class?: string;
}
---

<slot name="trigger"/>

<aside
        id={id}
        aria-labelledby={labelledby}
        aria-describedby={describedby}
        class:list={["aside-outer", className]}
        {...rest}
>
    <div class="aside-inner" data-color-theme="dune">
        <div class="flex h-full flex-col p-3 sm:p-4">
            <div class="flex items-start justify-between gap-4">
                <div>
                    <slot name="banner-content"/>
                </div>

                <!--<div class="self-stretch flex items-center">-->
                {useCloseButton === "true" && (
                        <button
                                type="button"
                                data-banner-close
                                aria-label={closeLabel}
                                class="button-sharp button-sharp-sub h-8 aspect-square"
                        >
                            ×
                        </button>
                )}
                <!--</div>-->

            </div>

            <slot/>
        </div>
    </div>
</aside>

<style>
    .aside-outer {
        display: none;

        position: fixed;
        //position: absolute;
        bottom: 0;
        left: 0;
        z-index: 80;
        flex-direction: column;
        place-items: center;
        place-content: center;
        width: 100%;

        margin: auto;
        padding-top: 10px;

        background-color: transparent;
        background-image: linear-gradient(
                45deg,
                transparent 33.33%,
                black 33.33%,
                black 50%,
                transparent 50%,
                transparent 83.33%,
                black 83.33%,
                black 100%
        );
        background-size: 0.28rem 0.28rem;

        translate: 0 100%;
        opacity: 0;

        transition-property: display, opacity, translate;
        transition-duration: 0.3s;
        transition-behavior: allow-discrete;
    }

    .aside-outer[data-open] {
        display: flex;
        opacity: 1;
        translate: 0 0;

        @starting-style {
            opacity: 0;
            translate: 0 100%;
        }
    }

    .aside-inner {
        box-sizing: border-box;
        width: 100%;
        height: 100%;

        border-top: 1px solid;
    }
</style>