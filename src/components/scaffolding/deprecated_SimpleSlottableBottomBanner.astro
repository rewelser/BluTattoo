---
interface Props {
    id: string;
    closeLabel?: string;
    labelledby?: string;
    describedby?: string;
    class?: string;
}

const {
    id,
    closeLabel = "Close dialog",
    labelledby,
    describedby,
    class: className,
} = Astro.props;
---

<slot name="trigger" />

<dialog
        id={id}
        aria-labelledby={labelledby}
        aria-describedby={describedby}
        class:list={["dialog-outer", className]}
>
    <div class="dialog-inner">
        <div class="flex h-full flex-col p-3 sm:p-4">
            <div class="flex items-start justify-between gap-4">
                <div>
                    <slot name="header" />
                </div>

                <button
                        type="button"
                        command="close"
                        commandfor={id}
                        aria-label={closeLabel}
                        class="button-sharp button-sharp-sub p-4 shrink-0"
                >
                    close
                </button>
            </div>

            <slot />
        </div>
    </div>
</dialog>

<style>
    .dialog-outer {
        position: fixed;
        position: absolute;
        bottom: 0;
        /* make this more deliberate */
        z-index: 80;
        flex-direction: column;
        place-items: center;
        place-content: center;
        width: 100%;

        margin: auto;
        padding-top: 10px;

        background-color: transparent;
        background-image: linear-gradient(
                45deg,
                transparent 33.33%,
                black 33.33%,
                black 50%,
                transparent 50%,
                transparent 83.33%,
                black 83.33%,
                black 100%
        );
        background-size: 0.28rem 0.28rem;

        translate: 0 100%;
        opacity: 0;

        transition-property: display, overlay, opacity, translate;
        transition-duration: 0.3s;
        transition-behavior: allow-discrete;
    }

    .dialog-outer[open] {
        display: flex;
        opacity: 1;
        translate: 0 0;

        @starting-style {
            opacity: 0;
            translate: 0 100%;
        }
    }

    .dialog-outer::backdrop {
        background-color: transparent;
        transition: background-color 0.3s allow-discrete;
    }

    .dialog-outer[open]::backdrop {
        background-color: rgb(0 0 0 / 30%);

        @starting-style {
            background-color: transparent;
        }
    }

    .dialog-inner {
        box-sizing: border-box;
        width: 100%;
        height: 100%;

        background: seashell;
        border-top: 1px solid black;
    }
</style>